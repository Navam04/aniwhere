# Aniwhere server settings. The installer writes this to /etc/anime/anime.env (Docker: the .env file).

# Full HTTPS name of the server on your tailnet: <machine name>.<tailnet name>.ts.net
# (find the tailnet name in the Tailscale admin console under DNS).
ANIME_HOST=anime.example-tailnet.ts.net

# Comma-separated Tailscale logins allowed to use the app. The first one is the owner.
# Required: with no logins set, anyone who can reach the server would be let in.
ANIME_ALLOWED_LOGINS=you@example.com

# Contact URL for push notifications (Apple needs a real https: or mailto: address).
ANIME_PUSH_SUBJECT=https://anime.example-tailnet.ts.net
