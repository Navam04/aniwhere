# Copy to .env next to docker-compose.yml and fill in.

# Machine name on your tailnet; the app will be at https://<name>.<tailnet>.ts.net
TS_HOSTNAME=anime
# Full HTTPS name: <TS_HOSTNAME>.<your tailnet name>.ts.net (tailnet name: Tailscale admin console > DNS)
ANIME_HOST=anime.example-tailnet.ts.net
# Comma-separated Tailscale logins allowed to use the app; the first is the owner. Required.
ANIME_ALLOWED_LOGINS=you@example.com
# Optional: a Tailscale auth key (admin console > Settings > Keys) to join without opening a login link.
TS_AUTHKEY=
# Optional: pin a release, e.g. 1.0.0 (default: latest)
ANIWHERE_VERSION=latest
